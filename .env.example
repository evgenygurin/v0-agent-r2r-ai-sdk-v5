# =============================================================================
# Claude Code SDK + R2R Integration Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Anthropic Claude Code SDK
# -----------------------------------------------------------------------------
# IMPORTANT: API key is OPTIONAL when using Claude MAX subscription
# The SDK automatically uses Claude Code CLI authentication (recommended)
# Only set this if you want to use direct API access instead of subscription
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude Code CLI Path (optional, auto-detected if installed globally)
# CLAUDE_CODE_PATH=/usr/local/bin/claude

# -----------------------------------------------------------------------------
# R2R Instance Configuration (Google Cloud Deployment)
# -----------------------------------------------------------------------------
R2R_BASE_URL=http://136.119.36.216:7272
R2R_DASHBOARD_URL=http://136.119.36.216:7273
HATCHET_DASHBOARD_URL=http://136.119.36.216:7274

# R2R Authentication (optional, depends on R2R configuration)
R2R_API_KEY=
R2R_ADMIN_EMAIL=
R2R_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Vercel Analytics
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# App URL for production
NEXT_PUBLIC_APP_URL=https://vercel.com/eagurins-projects/v0-agent-r2r-ai-sdk-v5

VERCEL_PROJECT_ID=prj_AWmz5XEh4zd6T6J4iG3A8r7AZSiC
VERCEL_TEAM_ID=team_vQW0xhMJhexCPBThcGxpeSpw

# Default model for Claude Code
NEXT_PUBLIC_DEFAULT_MODEL=sonnet

# Default RAG mode (basic, advanced, research, deepReasoning)
NEXT_PUBLIC_DEFAULT_RAG_MODE=advanced

# Enable debug logging
DEBUG=false

# -----------------------------------------------------------------------------
# Optional: Third-party Integrations
# -----------------------------------------------------------------------------

# GitHub Integration (for CI/CD, issue tracking)
GITHUB_TOKEN=
GITHUB_REPO=evgenygurin/agent-r2r-ai-sdk-v5
GITHUB_OWNER=evgenygurin

# Linear Integration (for project management)
# Get API key from: https://linear.app/settings/api
# Required for: Issue tracking, automation, webhooks
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_WEBHOOK_SECRET=  # For webhook signature verification

# CircleCI Integration (for CI/CD)
CIRCLECI_API_TOKEN=
CIRCLECI_PROJECT_SLUG=

# Sentry Integration (for error tracking & auto-resolution)
# Get DSN from: https://sentry.io/settings/projects/
# Auth token from: Settings → Developer Settings → Internal Integrations
SENTRY_DSN=
SENTRY_AUTH_TOKEN=  # Required for issue resolution API calls
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_WEBHOOK_SECRET=  # For webhook signature verification
NEXT_PUBLIC_SENTRY_DSN=

# Sentry Configuration
SENTRY_ENVIRONMENT=production
SENTRY_AUTO_RESOLVE=true  # Auto-resolve issues when PRs merge
SENTRY_MIN_SEVERITY=error  # Minimum severity to trigger automation

# Codegen.com Integration (AI-Powered Code Generation)
# Get credentials from: https://app.codegen.com/settings/api-keys
# Required for: Auto-fix, code review, PR automation
CODEGEN_API_KEY=
CODEGEN_ORG_ID=
CODEGEN_PROJECT_ID=

# Codegen Configuration
CODEGEN_AUTO_FIX_ENABLED=true
CODEGEN_AUTO_REVIEW_ENABLED=true
CODEGEN_MAX_TASK_WAIT_TIME=600000  # 10 minutes in ms

# -----------------------------------------------------------------------------
# Liveblocks (Real-time Collaboration)
# -----------------------------------------------------------------------------
# Get API key from: https://liveblocks.io/dashboard/projects
# Required for: Live cursors, presence, collaborative editing
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=
LIVEBLOCKS_SECRET_KEY=  # For server-side operations

# Liveblocks Configuration
LIVEBLOCKS_ENABLE_CURSORS=true
LIVEBLOCKS_ENABLE_PRESENCE=true
LIVEBLOCKS_ENABLE_COMMENTS=false  # Optional: commenting system

# -----------------------------------------------------------------------------
# MCP (Model Context Protocol) Servers
# -----------------------------------------------------------------------------
# MCP servers provide extended capabilities to Claude Code

# Context7 MCP Server (for enhanced context management)
MCP_CONTEXT7_ENABLED=false
MCP_CONTEXT7_URL=

# GitHub MCP Server (for repository operations)
MCP_GITHUB_ENABLED=false
MCP_GITHUB_TOKEN=

# Filesystem MCP Server (for file operations)
MCP_FILESYSTEM_ENABLED=false
MCP_FILESYSTEM_ALLOWED_DIRS=/Users/laptop/dev/v0-agent-r2r-ai-sdk-v5

# -----------------------------------------------------------------------------
# Advanced R2R Configuration
# -----------------------------------------------------------------------------

# Knowledge Graph Settings
R2R_ENABLE_KNOWLEDGE_GRAPH=true
R2R_MAX_ENTITIES=1000
R2R_ENABLE_COMMUNITY_DETECTION=true

# Search Settings
R2R_DEFAULT_SEARCH_LIMIT=10
R2R_ENABLE_HYBRID_SEARCH=true
R2R_SEMANTIC_WEIGHT=5.0
R2R_FULLTEXT_WEIGHT=1.0

# Chunking Settings
R2R_CHUNK_SIZE=1024
R2R_CHUNK_OVERLAP=256
R2R_CHUNKING_METHOD=recursive

# Performance Settings
R2R_ENABLE_CACHING=true
R2R_CACHE_TTL=3600
R2R_MAX_CONCURRENT_REQUESTS=10

# -----------------------------------------------------------------------------
# Closed-Loop Automation System
# -----------------------------------------------------------------------------
# Configuration for the AI-powered automation and self-healing system

# Webhook Orchestrator
WEBHOOK_ORCHESTRATOR_ENABLED=true
WEBHOOK_MAX_RETRIES=3
WEBHOOK_TIMEOUT_MS=30000

# Auto-Fix Configuration
AUTO_FIX_ENABLED=true
AUTO_FIX_CREATE_PR=true
AUTO_FIX_AUTO_MERGE=false  # Require manual review
AUTO_FIX_BRANCH_PREFIX=auto-fix/
AUTO_FIX_MAX_WAIT_TIME=600000  # 10 minutes

# Auto-Review Configuration
AUTO_REVIEW_ENABLED=true
AUTO_REVIEW_SKIP_DRAFTS=true
AUTO_REVIEW_SKIP_DEPENDABOT=true
AUTO_REVIEW_MIN_FILES_CHANGED=1

# Self-Healing CI/CD
SELF_HEALING_ENABLED=true
SELF_HEALING_MAX_RETRIES=3
SELF_HEALING_RETRY_DELAY_MS=5000

# Automation Rules
AUTO_CREATE_LINEAR_ISSUES=true
AUTO_RESOLVE_ON_PR_MERGE=true
AUTO_CLOSE_STALE_ISSUES=true
STALE_ISSUE_DAYS=30

# Notifications
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_CI_ALERTS=#ci-alerts
SLACK_CHANNEL_ERRORS=#prod-errors
NOTIFY_ON_AUTO_FIX=true
NOTIFY_ON_CRITICAL_ERROR=true

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# IMPORTANT: Never commit this file to git!
# Add .env.local to .gitignore

# Session Secret (generate with: openssl rand -hex 32)
SESSION_SECRET=

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://vercel.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# -----------------------------------------------------------------------------
# Development vs Production
# -----------------------------------------------------------------------------
NODE_ENV=development

# Enable detailed error messages in development
NEXT_PUBLIC_SHOW_ERROR_DETAILS=true

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# 1. Copy this file to .env.local and fill in your actual values
# 2. Never commit .env.local to version control
# 3. For production, use Vercel Environment Variables UI
# 4. Required variables: NONE (if using Claude MAX subscription)
# 5. Optional but recommended: R2R_API_KEY, GITHUB_TOKEN
# 6. MCP servers require additional setup - see MCP documentation
# 7. Claude MAX users: No need to set ANTHROPIC_API_KEY
# 8. For closed-loop automation, set: CODEGEN_*, LINEAR_*, SENTRY_* variables
# 9. Webhook secrets MUST be configured for security (Linear, Sentry)
# 10. See docs/AUTOMATION.md for complete setup guide
# =============================================================================
